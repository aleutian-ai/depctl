{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ragctl.dev/schemas/knowledge-package.schema.json",
  "title": "KnowledgePackage",
  "description": "Maps an ecosystem+package identity to knowledge sources ragctl can acquire.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "match", "version", "sources"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "ragctl.dev/v1alpha1" },
    "kind": { "const": "KnowledgePackage" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "match": {
      "type": "object",
      "required": ["ecosystems", "packages"],
      "additionalProperties": false,
      "properties": {
        "ecosystems": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["go", "python", "node", "rust", "java"] }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["semver-tag", "none", "manual"] },
        "repository": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "authority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["git", "godoc", "website", "github-releases"] },
          "url": { "type": "string" },
          "ref": { "type": "string" },
          "module": { "type": "string" },
          "authority": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
